{
  "defaultProvider": "devin",
  "defaultModel": "gemini-4-neon",
  "packages": [
    "npm:pi-web-access",
    "git:github.com/zhuasy/pi-better-devin-auth",
    "git:github.com/abhi-reducto/pi-morph",
    "git:github.com/jonaslsaa/pi-optchat"
  ],
  "theme": "clean-dark",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "steeringMode": "all",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "on"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "anthropic/claude-opus-4-8": {
        "reserveTokens": 872000
      }
    }
  }
}
